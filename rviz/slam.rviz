Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
    # Map display disabled: rviz's indexed-8bit-image shader fails to link on a wide
    # range of GPUs (unresolved upstream bug, ros2/rviz#1279: "active samplers with a
    # different type refer to the same texture image unit"). The map_to_pointcloud
    # node (started by slam.launch.py) republishes /map as /map_points instead, shown
    # below via the PointCloud2 display, which uses a different, working shader path.
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Map (PointCloud2)
      Topic:
        Value: /map_points
        Durability Policy: Transient Local
      Style: Flat Squares
      Size (Pixels): 3
      Color Transformer: RGB8
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
      Size (m): 0.03
      Color: 255; 0; 0
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 0.78
Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 60
